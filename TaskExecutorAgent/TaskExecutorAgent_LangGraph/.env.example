OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_RETRIES=2
ENABLE_REFLECTION=true
ENABLE_MEMORY=true

# Langfuse Cloud Configuration (https://langfuse.com)
# 1. Sign up for free at https://langfuse.com
# 2. Get API keys from Settings → API Keys
# 3. Copy/paste the keys below
LANGFUSE_PUBLIC_KEY=pk_your_public_key_here
LANGFUSE_SECRET_KEY=sk_your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: MCP Server Credentials
# AZURE_DEVOPS_TOKEN=
# GITHUB_TOKEN=
